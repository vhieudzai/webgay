<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vi Hieu Hub - Advanced Lua Deobfuscator</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-950 text-gray-100 min-h-screen flex flex-col justify-between p-4 md:p-6">
    <div class="max-w-5xl mx-auto w-full">
        <!-- Tiêu đề trang -->
        <header class="mb-4 border-b border-gray-800 pb-3 flex justify-between items-center">
            <div>
                <h1 class="text-xl md:text-2xl font-bold text-blue-400">Vi Hieu Hub - Advanced Deobfuscator</h1>
                <p class="text-xs md:text-sm text-gray-400">Hệ thống bóc tách, giải mã mã hóa siêu dài và chống obfuscate đa lớp.</p>
            </div>
            <span class="px-2.5 py-1 bg-blue-500/10 text-blue-400 border border-blue-500/20 text-xs font-mono rounded-md">v2.5 Pro</span>
        </header>

        <!-- Khu vực nhập và xuất code -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex flex-col">
                <label class="block mb-1 text-sm font-medium text-gray-300">Code gốc bị khóa (Obfuscated Code):</label>
                <textarea id="inputCode" class="w-full h-72 md:h-96 bg-gray-900 border border-gray-800 rounded-lg p-3 font-mono text-xs md:text-sm focus:outline-none focus:border-blue-500 resize-none text-gray-200" placeholder="Dán code mã hóa siêu dài vào đây..."></textarea>
            </div>
            <div class="flex flex-col">
                <label class="block mb-1 text-sm font-medium text-gray-300">Kết quả bóc tách sạch:</label>
                <textarea id="outputCode" readonly class="w-full h-72 md:h-96 bg-gray-900 border border-gray-800 rounded-lg p-3 font-mono text-xs md:text-sm focus:outline-none text-green-400 resize-none" placeholder="Code sau khi phá mã sẽ hiện ở đây..."></textarea>
            </div>
        </div>

        <!-- Thanh menu nút bấm -->
        <div class="mt-4 flex flex-wrap items-center gap-3">
            <button onclick="processCode()" class="bg-blue-600 hover:bg-blue-700 px-5 py-2.5 rounded-lg text-sm font-semibold transition shadow-lg shadow-blue-600/25">
                Bóc Tách Toàn Bộ
            </button>
            <button onclick="copyOutput()" class="bg-gray-800 hover:bg-gray-700 px-5 py-2.5 rounded-lg text-sm font-semibold transition border border-gray-700">
                Copy Kết Quả
            </button>
            <button onclick="clearAll()" class="bg-red-600/20 hover:bg-red-600/30 text-red-400 border border-red-500/30 px-5 py-2.5 rounded-lg text-sm font-semibold transition">
                Xóa Tất Cả
            </button>
        </div>
    </div>

    <!-- Footer -->
    <footer class="mt-6 text-center text-xs text-gray-500 border-t border-gray-900 pt-3">
        &copy; 2026 Vi Hieu Hub. All rights reserved.
    </footer>

    <script>
        function parseLuaString(rawData) {
            let bytes = [];
            let i = 0;
            while (i < rawData.length) {
                if (rawData[i] === '\\') {
                    let next = rawData[i+1];
                    if (next === 'x') {
                        let hex = rawData.substr(i+2, 2);
                        bytes.push(parseInt(hex, 16));
                        i += 4;
                    } else if (next >= '0' && next <= '9') {
                        let oct = "";
                        i++;
                        while (i < rawData.length && /\d/.test(rawData[i]) && oct.length < 3) {
                            oct += rawData[i];
                            i++;
                        }
                        bytes.push(parseInt(oct, 10));
                    } else if (next === 'n') { bytes.push(10); i += 2; }
                    else if (next === 't') { bytes.push(9); i += 2; }
                    else if (next === 'r') { bytes.push(13); i += 2; }
                    else if (next === '\\') { bytes.push(92); i += 2; }
                    else if (next === '"') { bytes.push(34); i += 2; }
                    else if (next === "'") { bytes.push(39); i += 2; }
                    else {
                        bytes.push(rawData.charCodeAt(i+1));
                        i += 2;
                    }
                } else {
                    bytes.push(rawData.charCodeAt(i));
                    i++;
                }
            }
            return bytes;
        }

        function processCode() {
            let code = document.getElementById('inputCode').value;
            if (!code.trim()) {
                alert("Chưa nhập code kìa mày!");
                return;
            }

            let result = code;
            let logInfo = [];

            try {
                // Vòng lặp bóc tách đa tầng (xử lý tối đa 5 lớp bảo vệ lồng nhau)
                let decodedAny = true;
                let loops = 0;

                while (decodedAny && loops < 5) {
                    decodedAny = false;
                    loops++;

                    // 1. Quét tìm cấu trúc biến chứa key và chuỗi mã hóa động (bất kể tên biến)
                    let keyMatches = [...result.matchAll(/local\s+([a-zA-Z_][a-zA-Z0-9_]*)\s*=\s*(\d+)/g)];
                    let dataMatches = [...result.matchAll(/local\s+([a-zA-Z_][a-zA-Z0-9_]*)\s*=\s*"([^"]{10,})"|local\s+([a-zA-Z_][a-zA-Z0-9_]*)\s*=\s*'([^']{10,})'/g)];

                    if (keyMatches.length > 0 && dataMatches.length > 0) {
                        // Lấy key đầu tiên tìm thấy
                        let key = parseInt(keyMatches[0][2], 10);
                        
                        // Ghép nối tất cả các chuỗi dữ liệu lớn nếu code bị phân mảnh nhiều biến
                        let fullRawData = "";
                        for (let dm of dataMatches) {
                            fullRawData += (dm[2] || dm[4] || "");
                        }

                        if (fullRawData.length > 0) {
                            let bytes = parseLuaString(fullRawData);
                            let decrypted = "";
                            for (let b of bytes) {
                                decrypted += String.fromCharCode(b ^ key);
                            }
                            result = decrypted;
                            logInfo.push(`[Lớp ${loops}] Giải mã XOR thành công với Key = ${key}, Data size = ${bytes.length} bytes.`);
                            decodedAny = true;
                            continue;
                        }
                    }

                    // 2. Trường hợp mã hóa chuỗi byte tổng quát không cần key
                    let hasEscapes = /\\(\d{1,3})|\\x[0-9A-Fa-f]{2}/.test(result);
                    if (hasEscapes && loops === 1) {
                        result = result.replace(/\\(\d{1,3})/g, (match, p1) => {
                            let codeNum = parseInt(p1, 10);
                            return (codeNum >= 0 && codeNum <= 255) ? String.fromCharCode(codeNum) : match;
                        });
                        result = result.replace(/\\x([0-9A-Fa-f]{2})/g, (match, p1) => {
                            return String.fromCharCode(parseInt(p1, 16));
                        });
                        logInfo.push(`[Lớp ${loops}] Giải mã chuỗi escape byte thuần túy.`);
                        decodedAny = true;
                    }
                }

                // Gắn log tổng kết lên đầu kết quả
                let headerLog = `-- [ VI HIEU HUB: BÓC TÁCH THÀNH CÔNG ${loops} LỚP BẢO VỆ ] --\n`;
                if (logInfo.length > 0) {
                    headerLog += `-- Log chi tiết:\n--   * ` + logInfo.join("\n--   * ") + `\n\n`;
                }
                result = headerLog + result;

            } catch (err) {
                result = "Lỗi khi xử lý bóc tách: " + err.message + "\n\nCode gốc:\n" + code;
            }

            document.getElementById('outputCode').value = result;
        }

        function copyOutput() {
            let output = document.getElementById('outputCode');
            if (!output.value.trim()) {
                alert("Không có gì để copy cả!");
                return;
            }
            navigator.clipboard.writeText(output.value);
            alert("Đã copy code sạch thành công!");
        }

        function clearAll() {
            document.getElementById('inputCode').value = '';
            document.getElementById('outputCode').value = '';
        }
    </script>
</body>
</html>
