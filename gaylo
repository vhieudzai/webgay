<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Protein Obfuscator - ColorOS Pro Edition</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            background: radial-gradient(circle at top left, #1a103c 0%, #0d0f18 50%, #080a10 100%);
            color: #f8fafc;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Header kính mờ ColorOS */
        header {
            background: rgba(24, 27, 40, 0.65);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            padding: 22px;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        header h1 {
            background: linear-gradient(135deg, #c084fc, #ec4899, #f43f5e);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        /* Layout Container */
        .container {
            display: flex;
            flex: 1;
            padding: 24px;
            gap: 20px;
            max-width: 1450px;
            margin: 0 auto;
            width: 100%;
        }

        @media (max-width: 950px) {
            .container {
                flex-direction: column;
            }
        }

        /* Khung kính mờ Glassmorphism */
        .editor-pane, .control-panel {
            background: rgba(24, 27, 40, 0.45);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            padding: 20px;
            box-shadow: 0 16px 40px 0 rgba(0, 0, 0, 0.45);
        }

        .editor-pane {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .pane-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .editor-pane label, .control-group label, .control-panel h3 {
            font-weight: 600;
            color: #cbd5e1;
            font-size: 14px;
        }

        .control-panel h3 {
            font-size: 16px;
            color: #f1f5f9;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-bottom: 10px;
            margin-bottom: 15px;
            letter-spacing: 0.3px;
        }

        /* Textarea kiểu mới */
        textarea {
            flex: 1;
            background: rgba(11, 13, 20, 0.65);
            color: #e2e8f0;
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 16px;
            padding: 16px;
            font-family: 'Fira Code', 'Courier New', Courier, monospace;
            font-size: 13px;
            resize: none;
            outline: none;
            min-height: 400px;
            transition: all 0.3s ease;
            line-height: 1.5;
        }

        textarea:focus {
            border-color: #c084fc;
            box-shadow: 0 0 0 4px rgba(192, 132, 252, 0.15);
            background: rgba(11, 13, 20, 0.85);
        }

        .control-panel {
            width: 300px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .control-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        /* Input, Select và Button */
        select, button {
            padding: 12px 14px;
            border-radius: 14px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(15, 23, 42, 0.7);
            color: #ffffff;
            font-size: 14px;
            outline: none;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        select:focus {
            border-color: #c084fc;
            box-shadow: 0 0 0 3px rgba(192, 132, 252, 0.15);
        }

        /* Nút bấm hiệu ứng */
        .btn-obfuscate {
            background: linear-gradient(135deg, #9333ea, #ec4899);
            color: white;
            font-weight: 700;
            border: none;
            box-shadow: 0 4px 20px rgba(147, 51, 234, 0.4);
            margin-top: 5px;
        }

        .btn-obfuscate:hover {
            opacity: 0.95;
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(236, 72, 153, 0.5);
        }

        .btn-action {
            background: rgba(51, 65, 85, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.08);
            font-weight: 500;
        }

        .btn-action:hover {
            background: rgba(71, 85, 105, 0.7);
        }

        .btn-clear {
            background: rgba(239, 68, 68, 0.15);
            border-color: rgba(239, 68, 68, 0.3);
            color: #f87171;
            font-size: 12px;
            padding: 6px 10px;
            border-radius: 8px;
        }

        .btn-clear:hover {
            background: rgba(239, 68, 68, 0.3);
        }
    </style>
</head>
<body>

    <header>
        <h1>Protein Obfuscator</h1>
    </header>

    <div class="container">
        <!-- Input Code -->
        <div class="editor-pane">
            <div class="pane-header">
                <label for="inputCode">Source Code Gốc (Lua/Luau)</label>
                <button class="btn-clear" onclick="clearInput()">Xóa Text</button>
            </div>
            <textarea id="inputCode" placeholder="-- Dán script Lua của ông vào đây...&#10;print('Protein Obfuscator Pro')"></textarea>
        </div>

        <!-- Options Panel -->
        <div class="control-panel">
            <h3>Cài Đặt Bảo Mật</h3>
            
            <div class="control-group">
                <label>Mức độ Obfuscate</label>
                <select id="level">
                    <option value="low">Cơ bản (Low)</option>
                    <option value="medium">Trung bình (Medium)</option>
                    <option value="high">Cực mạnh (High / Heavy)</option>
                    <option value="max" selected>Siêu mạnh (Max Security)</option>
                </select>
            </div>

            <div class="control-group">
                <label>Mã hóa chuỗi (String Encrypt)</label>
                <select id="stringEnc">
                    <option value="true">Bật (Khuyên dùng)</option>
                    <option value="false">Tắt</option>
                </select>
            </div>

            <button class="btn-obfuscate" onclick="startObfuscate()">Tiến Hành Obfuscate</button>
            <button class="btn-action" onclick="copyCode()">Copy Code Đã Mã Hóa</button>
        </div>

        <!-- Output Code -->
        <div class="editor-pane">
            <div class="pane-header">
                <label for="outputCode">Mã Nguồn Đã Mã Hóa (Protected Output)</label>
                <button class="btn-clear" onclick="clearOutput()">Xóa Kết Quả</button>
            </div>
            <textarea id="outputCode" readonly placeholder="-- Code sau khi obf sẽ hiện ở đây..."></textarea>
        </div>
    </div>

    <script>
        function startObfuscate() {
            const code = document.getElementById('inputCode').value;
            if (!code.trim()) {
                alert("Vui lòng nhập source code trước!");
                return;
            }

            const level = document.getElementById('level').value;
            const stringEnc = document.getElementById('stringEnc').value === 'true';
            const randomID = 'PR-' + Math.random().toString(36).substring(2, 10).toUpperCase();
            const timestamp = new Date().toISOString();

            let processedCode = code;

            if (stringEnc) {
                processedCode = processedCode.replace(/'([^']*)'|"([^"]*)"/g, function(match, p1, p2) {
                    const content = p1 !== undefined ? p1 : p2;
                    const bytes = [];
                    for (let i = 0; i < content.length; i++) {
                        bytes.push(content.charCodeAt(i));
                    }
                    return `string.char(${bytes.join(',')})`;
                });
            }

            let obfuscated = "";

            if (level === 'low') {
                const bytes = processedCode.split('').map(c => c.charCodeAt(0));
                obfuscated = `--[[ [ PROTECTED BY PROTEIN OBFUSCATOR ]\n     ID: ${randomID} | Level: Low ]]--\nlocal _p = {${bytes.join(',')}};\nlocal function _r(t)\n    local s = "";\n    for _, v in ipairs(t) do s = s .. string.char(v) end;\n    return loadstring(s)();\nend;\n_r(_p);`;
            } else if (level === 'medium') {
                const bytes = processedCode.split('').map(c => c.charCodeAt(0) ^ 5);
                obfuscated = `--[[ [ PROTECTED BY PROTEIN OBFUSCATOR ]\n     ID: ${randomID} | Level: Medium ]]--\nlocal _env = {}\nlocal _dat = {${bytes.join(',')}};\nlocal function _exec(d)\n    local res = "";\n    for i = 1, #d do res = res .. string.char(d[i] ~ 5) end;\n    return loadstring(res)();\nend;\n_exec(_dat);`;
            } else if (level === 'high') {
                const bytes = processedCode.split('').map(c => (c.charCodeAt(0) + 3) % 256);
                obfuscated = `--[[ ========================================\n     PROTEIN OBFUSCATOR - HEAVY SECURE\n     ID: ${randomID}\n     Date: ${timestamp}\n     ======================================== ]]\n(function()\n    local _k = ${Math.floor(Math.random() * 50) + 10};\n    local _payload = {${bytes.join(',')}};\n    local function _unpack(arr)\n        local out = "";\n        for _, val in ipairs(arr) do\n            out = out .. string.char((val - 3) % 256);\n        end\n        return out;\n    end\n    local status, res = pcall(function()\n        return loadstring(_unpack(_payload))()\n    end);\n    if not status then\n        warn("[Protein Error]: Failed to initialize secure block.");\n    end\nend)();`;
            } else {
                // MAX SECURITY LEVEL (Siêu mạnh: XOR Key động + Đa lớp hàm bọc + Giả mạo cấu trúc)
                const key = Math.floor(Math.random() * 100) + 15;
                const bytes = processedCode.split('').map(c => (c.charCodeAt(0) ~ key));
                obfuscated = `--[[ ====================================================\n     PROTEIN OBFUSCATOR - MAX SECURITY EDITION\n     ID: ${randomID} | Secured: ${timestamp}\n     ==================================================== ]]\n(function()\n    local _KEY = ${key};\n    local _DUMMY = {0x50, 0x52, 0x4F, 0x54, 0x45, 0x49, 0x4E};\n    local _STREAM = {${bytes.join(',')}};\n    local function _DECRYPT(_ARR, _K)\n        local _OUT = "";\n        for _I = 1, #_ARR do\n            _OUT = _OUT .. string.char(_ARR[_I] ~ _K);\n        end\n        return _OUT;\n    end\n    local _SUCC, _RES = pcall(function()\n        local _EXEC_FUNC = loadstring or load;\n        if type(_EXEC_FUNC) == "function" then\n            return _EXEC_FUNC(_DECRYPT(_STREAM, _KEY))();\n        end\n    end);\n    if not _SUCC then\n        error("[Protein Critical]: Environment execution blocked or invalid bytecode.");\n    end\nend)();`;
            }

            document.getElementById('outputCode').value = obfuscated;
        }

        function copyCode() {
            const output = document.getElementById('outputCode');
            if (!output.value) {
                alert("Chưa có code để copy!");
                return;
            }
            output.select();
            navigator.clipboard.writeText(output.value);
            alert("Đã copy code đã mã hóa vào clipboard!");
        }

        function clearInput() {
            document.getElementById('inputCode').value = '';
        }

        function clearOutput() {
            document.getElementById('outputCode').value = '';
        }
    </script>
</body>
</html>
