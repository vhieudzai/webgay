<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Vi Hieu Hub — Lua Vault</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0b0d12; --panel:#12151d; --panel-2:#171b25; --line:#242a38;
  --text:#dfe4ee; --muted:#7c8699; --amber:#f0a73a; --violet:#9b8cf2; --danger:#e8667a;
  --mono:'JetBrains Mono',ui-monospace,monospace; --sans:'Space Grotesk',system-ui,sans-serif;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: light){
  :root:not([data-theme="dark"]){--bg:#f3f1ea;--panel:#fffdf8;--panel-2:#ece8dd;--line:#d9d3c3;--text:#1c1d1f;--muted:#6b6557;}
}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);min-height:100%;}
.wrap{max-width:1180px;margin:0 auto;padding:22px 20px 40px;}
header{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;border-bottom:1px solid var(--line);padding-bottom:16px;margin-bottom:20px;flex-wrap:wrap;}
header h1{font-size:1.5rem;margin:0;font-weight:700;letter-spacing:-0.01em;}
header h1 span{color:var(--amber);}
header p{margin:4px 0 0;color:var(--muted);font-size:.85rem;}
.badge{font-family:var(--mono);font-size:.72rem;color:var(--amber);border:1px solid var(--line);padding:4px 10px;border-radius:4px;background:var(--panel);white-space:nowrap;}

.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
@media(max-width:860px){.grid{grid-template-columns:1fr;}}
.col label{display:block;font-size:.78rem;color:var(--muted);margin-bottom:6px;}
textarea{width:100%;height:280px;background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:12px;color:var(--text);font-family:var(--mono);font-size:.8rem;resize:vertical;outline:none;}
textarea:focus{border-color:var(--amber);}
#outputCode{color:#8fd6a3;}

.panel{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:14px 16px;margin-top:14px;}
.panel h2{font-size:.82rem;margin:0 0 10px;color:var(--muted);font-weight:600;}
.settings{display:flex;flex-wrap:wrap;gap:18px;align-items:center;}
.field{display:flex;flex-direction:column;gap:5px;}
.field span{font-size:.72rem;color:var(--muted);}
.field input[type=number],.field input[type=text]{background:var(--panel-2);border:1px solid var(--line);color:var(--text);border-radius:4px;padding:6px 8px;font-family:var(--mono);font-size:.8rem;}
.field input[type=number]{width:70px;}
.check{display:flex;align-items:center;gap:7px;font-size:.78rem;color:var(--text);cursor:pointer;}
.check input{accent-color:var(--amber);}

.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px;}
button{font-family:var(--sans);font-weight:600;font-size:.82rem;border:1px solid transparent;border-radius:6px;padding:10px 16px;cursor:pointer;transition:filter .15s;}
button:hover{filter:brightness(1.12);}
.btn-amber{background:var(--amber);color:#1a1200;}
.btn-violet{background:var(--violet);color:#15102e;}
.btn-ghost{background:var(--panel-2);color:var(--text);border-color:var(--line);}
.btn-danger{background:transparent;color:var(--danger);border-color:var(--danger);}

#log{font-family:var(--mono);font-size:.74rem;color:var(--muted);white-space:pre-wrap;line-height:1.55;max-height:160px;overflow-y:auto;}
#log b{color:var(--amber);}
footer{text-align:center;color:var(--muted);font-size:.72rem;margin-top:30px;border-top:1px solid var(--line);padding-top:14px;}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div>
      <h1>Vi Hieu Hub <span>// Lua Vault</span></h1>
      <p>Đóng gói Lua chạy thật nhiều tầng bằng XOR xoay vòng, xáo tên biến, chèn rác.</p>
    </div>
    <span class="badge">v4.0 — Multi-Layer</span>
  </header>

  <div class="grid">
    <div class="col">
      <label for="inputCode">Code đầu vào</label>
      <textarea id="inputCode" placeholder="Dán code Lua (gốc hoặc đã mã hóa) vào đây..."></textarea>
    </div>
    <div class="col">
      <label for="outputCode">Kết quả</label>
      <textarea id="outputCode" readonly placeholder="Kết quả xuất hiện ở đây..."></textarea>
    </div>
  </div>

  <div class="panel">
    <h2>Tùy chọn mã hóa</h2>
    <div class="settings">
      <div class="field"><span>Số lớp</span><input id="numLayers" type="number" value="3" min="1" max="8"></div>
      <div class="field"><span>Key tối thiểu</span><input id="keyMin" type="number" value="20" min="1" max="254"></div>
      <div class="field"><span>Key tối đa</span><input id="keyMax" type="number" value="245" min="2" max="255"></div>
      <label class="check"><input id="optJunk" type="checkbox" checked> Chèn biến rác mỗi lớp</label>
      <label class="check"><input id="optRot" type="checkbox" checked> Xoay key theo vị trí byte</label>
      <label class="check"><input id="optRand" type="checkbox" checked> Tên biến ngẫu nhiên</label>
    </div>
  </div>

  <div class="actions">
    <button class="btn-violet" onclick="encodeMulti()">Mã Hóa Nhiều Lớp</button>
    <button class="btn-ghost" onclick="copyOutput()">Copy Kết Quả</button>
    <button class="btn-danger" onclick="clearAll()">Xóa Tất Cả</button>
  </div>

  <div class="panel">
    <h2>Nhật ký xử lý</h2>
    <div id="log">Chưa có hoạt động nào.</div>
  </div>

  <footer>© 2026 Vi Hieu Hub — công cụ bảo vệ script cá nhân, dùng cho mục đích học tập &amp; bảo vệ code của bạn.</footer>
</div>

<script>
const $ = id => document.getElementById(id);
function log(lines){ $('log').innerHTML = lines.map(l=>l.replace(/\[(.*?)\]/,'<b>[$1]</b>')).join('\n'); }
function randInt(a,b){ return Math.floor(Math.random()*(b-a+1))+a; }
function randName(){
  const chars='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';
  let s='_'+chars[randInt(0,chars.length-1)];
  for(let i=0;i<randInt(3,6);i++) s+=chars[randInt(0,chars.length-1)];
  return s;
}

// ---------- ENCODE ----------
function wrapLayer(code, key, opts){
  const kVar=opts.rand?randName():'_k', bVar=opts.rand?randName():'_b', sVar=opts.rand?randName():'_s', iVar=opts.rand?randName():'_i';
  const bytes=[];
  for(let i=0;i<code.length;i++){
    let k=key;
    if(opts.rot) k = (key + (i % 17)) % 256;
    bytes.push(code.charCodeAt(i) ^ k);
  }
  let junk='';
  if(opts.junk){
    const jv=randName();
    junk = `local ${jv}=${randInt(1000,99999)};`;
  }
  const rotExpr = opts.rot ? `((${kVar}+((${iVar}-1)%17))%256)` : kVar;
  return `local ${kVar}=${key};${junk}local ${bVar}={${bytes.join(',')}};local ${sVar}="";`+
         `for ${iVar}=1,#${bVar} do ${sVar}=${sVar}..string.char(${bVar}[${iVar}]~${rotExpr}) end;`+
         `(loadstring or load)(${sVar})();`;
}

function encodeMulti(){
  const src=$('inputCode').value;
  if(!src.trim()){ alert('Nhập code cần mã hóa đã!'); return; }
  const layers=Math.max(1,Math.min(8,parseInt($('numLayers').value)||3));
  let kmin=parseInt($('keyMin').value)||20, kmax=parseInt($('keyMax').value)||245;
  if(kmax<=kmin) kmax=kmin+1;
  const opts={ junk:$('optJunk').checked, rot:$('optRot').checked, rand:$('optRand').checked };
  let code=src, lines=[`-- [VI HIEU HUB] Mã hóa ${layers} lớp thành công --`];
  for(let i=1;i<=layers;i++){
    const key=randInt(kmin,kmax);
    code=wrapLayer(code,key,opts);
    lines.push(`[Lớp ${i}] key=${key}${opts.rot?' (xoay theo vị trí)':''}${opts.rand?' · tên biến ngẫu nhiên':''}${opts.junk?' · có biến rác':''}`);
  }
  code = `-- obf by protein\n` + code;
  $('outputCode').value = code;
  log(lines);
}

function copyOutput(){
  const o=$('outputCode');
  if(!o.value.trim()){ alert('Không có gì để copy!'); return; }
  navigator.clipboard.writeText(o.value).then(()=>alert('Đã copy kết quả!'));
}
function clearAll(){ $('inputCode').value=''; $('outputCode').value=''; log(['Đã xóa.']); }
</script>
</body>
</html>

